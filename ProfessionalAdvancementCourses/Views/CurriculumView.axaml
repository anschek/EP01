<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProfessionalAdvancementCourses.Views.CurriculumView"
			 xmlns:vm="using:ProfessionalAdvancementCourses.ViewModels"
             x:DataType="vm:CurriculumViewModel">
	<StackPanel  Margin="10">
		<TextBlock Text="Учебный план" Classes="h2"/>
		<TextBlock Text="Выберите группу"/>
		<StackPanel Orientation="Horizontal">
			<ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberBinding="{Binding Name}"/>
			<Button Content="Показать" Command="{Binding GetCurriculum}"/>
		</StackPanel>
		<ListBox ItemsSource="{Binding Curriculum}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="{Binding Lesson}"/>
						<TextBlock Text="{Binding TotalPlannedHours,StringFormat='Часов всего: {0}'}"/>
						<TextBlock Text="{Binding RemainingHours,StringFormat='Часов осталось: {0}'}"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>
</UserControl>
