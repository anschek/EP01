<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<StackPanel>
				<TextBlock Classes="h1" Text="Заголовок 1"/>
				<TextBlock Classes="h2" Text="Заголовок 2"/>
				<TextBlock Classes="h3" Text="Заголовок 3"/>
				<TextBlock Text="Обычный текст"/>
				<ComboBox PlaceholderText="Выбор из списка"/>
				<TextBox Watermark="Введите текст..."/>
				<Button Content="Кнопка" />
			</StackPanel>
		</Border>
	</Design.PreviewWith>

	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="32"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="Purple"/>
		<Setter Property="Margin" Value="0,0,0,10"/>
	</Style>	
	
	<Style Selector="TextBlock.h2">
		<Setter Property="FontSize" Value="24"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Margin" Value="0,0,0,10"/>
	</Style>	
	
	<Style Selector="TextBlock.h3">
		<Setter Property="FontSize" Value="19"/>
		<Setter Property="FontWeight" Value="SemiLight"/>
		<Setter Property="Foreground" Value="Purple"/>
		<Setter Property="Margin" Value="0,0,0,10"/>
	</Style>

	<Style Selector="TextBlock">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Margin" Value="0,0,5,5"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

	<Style Selector="TextBox">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Padding" Value="5"/>
		<Setter Property="Margin" Value="0,10,0,10"/>
		<Setter Property="BorderBrush" Value="DarkGray"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Width" Value="180"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
	</Style>
	
	<Style Selector="ComboBox">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Padding" Value="5"/>
		<Setter Property="Margin" Value="0,10,0,10"/>
		<Setter Property="BorderBrush" Value="DarkGray"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Width" Value="180"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="PlaceholderForeground" Value="Gray"/>
	</Style>

	<Style Selector="Button">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="Padding" Value="10,5"/>
		<Setter Property="Background" Value="Purple"/>
		<Setter Property="Width" Value="180"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
	</Style>
</Styles>